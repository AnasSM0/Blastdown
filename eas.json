{
  "cli": {
    "version": "23.2.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "android-qualification-fallback": {
      "node": "22.23.1",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_CINEMATIC_BOARD": "0"
      }
    },
    "android-qualification-cinematic": {
      "node": "22.23.1",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "image": "ubuntu-26.04-jdk-17-ndk-r27b-sdk-57",
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_CINEMATIC_BOARD": "1"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
