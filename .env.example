# Copy this file to .env and fill in real values for local development.
# .env is gitignored; never commit real production ad unit IDs or secrets.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Google AdMob app IDs.
# Defaults to Google's published test app IDs when unset (safe for dev/preview).
# Production builds MUST set the current platform's real value in the EAS
# production environment, not this file.
ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# Production rewarded-unit IDs. Missing values fail closed at runtime: the
# corresponding surface returns unavailable and never grants its reward.
ADMOB_ANDROID_REWARDED_FREEZE_UNIT_ID=
ADMOB_ANDROID_REWARDED_DEFUSE_UNIT_ID=
ADMOB_IOS_REWARDED_FREEZE_UNIT_ID=
ADMOB_IOS_REWARDED_DEFUSE_UNIT_ID=
